# Backend - copy to .env
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_places_api_key_here
GOOGLE_CSE_CX=your_google_programmable_search_engine_id_here
SERPER_API_KEY=your_serper_dev_api_key_here
SPOONACULAR_KEY=your_spoonacular_api_key_here
UNSPLASH_KEY=your_unsplash_api_key_here
DEMO_MODE=false

# Frontend Maps (use same key as GOOGLE_API_KEY)
VITE_GOOGLE_MAPS_KEY=

# Optional: CORS (default includes localhost:5173)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
