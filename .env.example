# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_places_api_key_here
GOOGLE_CSE_CX=your_google_custom_search_engine_id_here
SPOONACULAR_KEY=your_spoonacular_api_key_here
UNSPLASH_KEY=your_unsplash_api_key_here

# Application Configuration
LOG_LEVEL=INFO
DEMO_MODE=false

# CORS Configuration (comma-separated list of allowed origins)
# Development: Use localhost URLs
# Production: Replace with your actual frontend domain(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# Rate Limiting
# Maximum number of requests per client within the time window
RATE_LIMIT_REQUESTS=10
# Time window in seconds
RATE_LIMIT_WINDOW=60
